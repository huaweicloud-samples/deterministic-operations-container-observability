# terraform.tfvars 示例：复制为 terraform.tfvars 并修改
# CCE 节点登录用的密钥对：先在 ECS 控制台创建密钥对，填入名称
region             = "cn-north-4"
project_name       = "container-obs"
node_flavor        = "s6.large.2"
node_count         = 1
node_keypair_name  = "your-keypair-name"
cluster_eip_bandwidth = 5
lts_ttl_days       = 7